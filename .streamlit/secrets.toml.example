# Single secrets file for the whole project.
# Copy this to `.streamlit/secrets.toml` (same folder) and fill in your keys.
# `.streamlit/secrets.toml` is gitignored — it will NOT be committed/submitted.
#
# NEVER put real keys in THIS .example file — it is committed. Only in secrets.toml.
#
# Read by BOTH surfaces:
#   - the Streamlit UI (app.py, via st.secrets)
#   - live trading (main.py / config.py)
#
# Binance TESTNET and MAINNET keys are NOT interchangeable:
#   - Testnet keys: generate at https://testnet.binancefuture.com  (keep BINANCE_TESTNET = true)
#   - Mainnet (real money): set BINANCE_TESTNET = false  (not recommended for coursework)

BINANCE_API_KEY    = "your-testnet-api-key-here"
BINANCE_API_SECRET = "your-testnet-api-secret-here"
BINANCE_TESTNET    = true

# Optional — pin live-framework run settings here instead of passing env vars:
# MODE = "live"
# EXECUTION = "live"
# MARKET_FEED = "binance"
# SYMBOLS = "BTCUSDT,ETHUSDT"
